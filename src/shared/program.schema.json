{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coach-program",
  "title": "Coach Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "startDate", "weeks", "sessions"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weeks": { "type": "integer", "minimum": 1 },
    "notes": { "type": "string" },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title", "week", "exercises"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "week": { "type": "integer", "minimum": 1 },
        "focus": { "type": "string" },
        "notes": { "type": "string" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sets", "reps"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sets": { "type": "integer", "minimum": 1 },
        "reps": { "type": "string", "minLength": 1 },
        "intensity": { "type": "string" },
        "backoff": { "type": "string" },
        "supersetWith": { "type": "string" },
        "notes": { "type": "string" },
        "coachNote": { "type": "string" }
      }
    }
  }
}
